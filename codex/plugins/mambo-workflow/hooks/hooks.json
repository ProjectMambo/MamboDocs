{
  "description": "Synchronize canonical Project Mambo docs and run advisory repository checks after Codex edits.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/post_edit.py\"",
            "timeout": 120,
            "statusMessage": "Checking Project Mambo standards"
          }
        ]
      }
    ]
  }
}
